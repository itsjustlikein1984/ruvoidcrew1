/// Tiny5 — пиксельный шрифт с полной поддержкой кириллицы (U+0400–U+04FF).
/// Используется в .maptext (рунчат, GPS, счётчики, HUD-цифры) вместо Grand9K Pixel,
/// у которого нет русских букв — из-за чего кириллица уходила в системный fallback
/// и выглядела размытой.
/// Размеры: только pt, кратные 6 (6pt, 12pt, 18pt, 24pt).
/datum/font/tiny5
	name = "Tiny5"
	font_family = 'interface/fonts/Tiny5.ttf'
